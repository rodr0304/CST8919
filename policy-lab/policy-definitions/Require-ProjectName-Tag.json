{
  "properties": {
    "displayName": "Require-ProjectName-Tag",
    "policyType": "Custom",
    "mode": "All",
    "description": "Requires all resources to include a ProjectName tag.",
    "metadata": {
      "category": "Security",
      "createdBy": "aba19b4a-9ce4-482b-8bb3-52ae74978dd2",
      "createdOn": "2026-08-02T22:21:49.1848147Z",
      "updatedBy": null,
      "updatedOn": null
    },
    "version": "1.0.0",
    "policyRule": {
      "if": {
        "field": "[concat('tags[', 'ProjectName', ']')]",
        "exists": "false"
      },
      "then": {
        "effect": "deny"
      }
    },
    "versions": [
      "1.0.0"
    ]
